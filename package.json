{
  "name": "@clhbid/canadian-time-zone-hotpatch",
  "version": "0.1.1",
  "description": "A side-effect-free Temporal adapter that detects and corrects stale Canadian permanent-time zone data (Alberta, British Columbia, Manitoba) without patching Temporal or Intl globally.",
  "keywords": [
    "temporal",
    "timezone",
    "canada",
    "alberta",
    "british-columbia",
    "manitoba",
    "daylight-saving-time"
  ],
  "homepage": "https://github.com/clhbid/canadian-time-zone-hotpatch#readme",
  "bugs": {
    "url": "https://github.com/clhbid/canadian-time-zone-hotpatch/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clhbid/canadian-time-zone-hotpatch.git"
  },
  "license": "MIT",
  "author": "CLHbid",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepack": "npm run build",
    "release:validate": "npm run build && npm run typecheck && npm test && npm run lint && npm run format && npm pack --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.9.8",
    "temporal-polyfill": "^1.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "temporal-spec": "^1.0.1"
  }
}
